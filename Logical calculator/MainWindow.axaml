<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Logical_calculator"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        MinWidth="600" 
        MinHeight="500"
        Width="600"
        Height="700"
        x:Class="Logical_calculator.MainWindow"
        x:DataType="local:MainWindow"
        Title="Logical_calculator">
    
    <Window.Styles>
        <Style Selector="Button.key-btn">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <Style Selector="Button.calc-btn">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.export-btn">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        
        <Style Selector="TextBlock.column-header">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        
        <Style Selector="TextBlock.stat-label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Styles>
    
    <Grid ColumnDefinitions="325, *">
        
        <!-- Добавлена ещё одна строка (Row 5) под кнопкой "Рассчитать" -->
        <Grid Grid.Column="0" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, *">
            
            <TextBlock Grid.Row="0"
                       Text="Ввод данных"
                       Classes="column-header" />
            
            <TextBox Grid.Row="1"
                     x:Name="EquationTextBox"
                     FontSize="32"
                     Margin="30,0,30,12"
                     HorizontalAlignment="Stretch"
                     MinWidth="200"
                     VerticalContentAlignment="Center"
                     TextWrapping="NoWrap"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            
            <TextBlock Grid.Row="2"
                       x:Name="ErrorTextBlock"
                       TextAlignment="Center"
                       Padding="0,0,0,12"
                       VerticalAlignment="Center"
                       Foreground="Red"/>
            
            <ItemsControl Grid.Row="3" 
                          ItemsSource="{Binding KeyboardSymbols}"
                          Margin="0,0,0,10"
                          HorizontalAlignment="Center">
                
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" 
                                Classes="key-btn" 
                                Click="SymbolButton_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                
            </ItemsControl>
            
            <Button Grid.Row="4"
                    x:Name="CalculateButton"
                    Content="Рассчитать"
                    HorizontalContentAlignment="Center"
                    VerticalAlignment="Top"
                    Background="DarkSeaGreen"
                    Classes="calc-btn"
                    Click="CalculateButton_Click" /> 
            
            <Border Grid.Row="5" Grid.ColumnSpan="2"
                    BorderBrush="Gray"
                    x:Name="ExportBlock"
                    IsVisible="False"
                    BorderThickness="0,1,0,0"
                    Margin="0,14,0,0"
            >
                <StackPanel 
                            Orientation="Vertical"
                            HorizontalAlignment="Left"
                            Margin="20,0,0,4">
                            
                    <TextBlock 
                               Text="Экспортировать как"
                               Classes="section-header" />
                        

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ExportXlsxButton"
                                Content="xlsx"
                                Classes="export-btn"
                                Background="#217346"
                                Foreground="White"
                                Click="ExportXlsxButton_Click" />
                            
                        <Button x:Name="ExportMarkdownButton"
                                Content="markdown"
                                Classes="export-btn"
                                Background="#444444"
                                Foreground="White"
                                Click="ExportMarkdownButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name = "ExportInfo"/>
                </StackPanel>
            </Border>
            
        </Grid>
        
        <Grid Grid.Column="1" RowDefinitions="Auto, Auto, Auto, Auto, *">
            
            <TextBlock Grid.Row="0" 
                       Text="Таблица истинности"
                       TextAlignment="Left"
                       Classes="column-header" />
            
            <Border Grid.Row="1"
                    Background="Transparent"
                    BorderBrush="Gray"
                    BorderThickness="1,0,0,0"
                    Padding="16,12"
                    Margin="0,0,0,0">
                
                <Grid ColumnDefinitions="3*, 1*" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">
                    
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Положительных исходов:"
                               Classes="stat-label" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               x:Name="PositiveCountText"
                               Text=""
                               Classes="stat-value" />
                    
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Отрицательных исходов:"
                               Classes="stat-label"
                               Margin="0,8,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               x:Name="NegativeCountText"
                               Text=""
                               Classes="stat-value"
                               Margin="0,8,0,0" />
                    
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Тавтология:"
                               Classes="stat-label"
                               Margin="0,8,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               x:Name="TautologyText"
                               Text=""
                               Classes="stat-value"
                               Margin="0,8,0,0" />
                    
                </Grid>
                
            </Border>
            <Border Grid.Row="4"
                    Background="Transparent"
                    BorderBrush="Gray"
                    BorderThickness="1,0,0,0"
                    CornerRadius="0"
                    Padding="16"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="0,0,0,0">
                
                <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="ResultGrid" />
                </ScrollViewer>
                
            </Border>
        </Grid>

    </Grid>
</Window>